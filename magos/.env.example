# MAGOS runtime
MAGOS_00A_FOLDER_ID=
MAGOS_AUDIT_SPREADSHEET_ID=1Y4iP2mVCIph8MrIL51mo-KpzgUkZbWW7ZUIlkH8lOTw
MAGOS_AUTOMATION_ID=MAGOS-DOC-EXTRACT-01
MAGOS_MAX_FILES_PER_RUN=25

# MAGOS Automation Runtime V1 (P3)
# Store MAGOS_RUNTIME_TOKEN only in the deployment platform secret store.
MAGOS_RUNTIME_TOKEN=
# Separate read-only Command Centre token; MUST NOT equal runtime/ingress tokens.
# Set only in private hosting environment, never commit a real credential.
# Shared privately with the live WordPress quote acceptance verifier.
# This must match the WordPress legacy bridge's REST authentication token.
# Never commit a real credential or reuse a runtime writer token.
# Existing WP legacy quote-acceptance config uses one link_secret for signed
# token validation and its REST bearer authentication. Keep both values aligned
# with that private WordPress secret without disclosing it.
MAGOS_WP_ACCEPTANCE_LINK_SECRET=
MAGOS_QUOTE_SIGNING_TOKEN=
MAGOS_WP_ACCEPTANCE_VERIFY_TOKEN=
MAGOS_WP_SITE_URL=https://myriadgreen.co.za
MAGOS_OPERATOR_READ_TOKEN=
# Independent business-action credentials. Missing token means endpoint disabled.
# Never share tokens across runtime, operator, supplier governance, job and procurement.
MAGOS_SUPPLIER_APPROVAL_TOKEN=
MAGOS_JOB_CREATION_TOKEN=
MAGOS_PROCUREMENT_APPROVAL_TOKEN=
MAGOS_CONTROL_HUB_SPREADSHEET_ID=1lxFrUEGeEojkxbpQiVfj1AxuB5C1ayaTzAT8rkaTObo
MAGOS_AGENT_MATRIX_SPREADSHEET_ID=1FKj-iudwat5bbFIrplgg237-ABPRq3ijQulf-LbSuBs
MAGOS_RUNTIME_URL=
MAGOS_RUNTIME_VERSION=P3
# Set from a verified deployment checkout before starting the Node worker.
# This is not a secret; the running process exposes it only to authenticated probes.
MAGOS_DEPLOY_COMMIT_SHA=
# Pass the expected exact 40-character SHA to the read-only host release preflight.
MAGOS_EXPECTED_GIT_SHA=
# Managed Node hosting normally injects PORT. Leave this blank unless support requires an override.
MAGOS_PORT=
# Hosted default is 0.0.0.0; leave unset unless the platform requires a specific bind address.
MAGOS_BIND_HOST=

# Separate least-privilege ingress credentials for website/lead adapters.
# Never reuse MAGOS_RUNTIME_TOKEN here.
MAGOS_LEAD_INGRESS_TOKEN=
MAGOS_LEAD_INGRESS_SOURCES=

# Google service authentication.
# Prefer workload/application default credentials in production.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Bounded transient Google Sheets retry policy.
# Defaults allow a per-minute quota window to recover without stranding an event.
MAGOS_SHEETS_RETRY_ATTEMPTS=7
MAGOS_SHEETS_RETRY_BASE_MS=1000
MAGOS_SHEETS_RETRY_MAX_MS=30000

# PDF.co is an escalation adapter, not the default extractor.
PDFCO_API_KEY=
PDFCO_OCR_MODE=Auto
PDFCO_ENABLE_AI_INVOICE=false
PDFCO_TEMPLATE_MAP_JSON={}

# Minimum native text quality before paid OCR is considered.
MAGOS_NATIVE_MIN_CHARS=80
MAGOS_NATIVE_MIN_ALNUM_RATIO=0.25
