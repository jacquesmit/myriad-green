# MAGOS runtime
MAGOS_00A_FOLDER_ID=
MAGOS_AUDIT_SPREADSHEET_ID=1Y4iP2mVCIph8MrIL51mo-KpzgUkZbWW7ZUIlkH8lOTw
MAGOS_AUTOMATION_ID=MAGOS-DOC-EXTRACT-01
MAGOS_MAX_FILES_PER_RUN=25

# MAGOS Automation Runtime V1 (P3)
# Store MAGOS_RUNTIME_TOKEN only in the deployment platform secret store.
MAGOS_RUNTIME_TOKEN=
MAGOS_RUNTIME_URL=
MAGOS_RUNTIME_VERSION=P3
MAGOS_PORT=8080

# Separate least-privilege ingress credentials for website/lead adapters.
# Never reuse MAGOS_RUNTIME_TOKEN here.
MAGOS_LEAD_INGRESS_TOKEN=
MAGOS_LEAD_INGRESS_SOURCES=

# Google service authentication.
# Prefer workload/application default credentials in production.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# PDF.co is an escalation adapter, not the default extractor.
PDFCO_API_KEY=
PDFCO_OCR_MODE=Auto
PDFCO_ENABLE_AI_INVOICE=false
PDFCO_TEMPLATE_MAP_JSON={}

# Minimum native text quality before paid OCR is considered.
MAGOS_NATIVE_MIN_CHARS=80
MAGOS_NATIVE_MIN_ALNUM_RATIO=0.25
