# MAGOS runtime
MAGOS_00A_FOLDER_ID=
MAGOS_AUDIT_SPREADSHEET_ID=1Y4iP2mVCIph8MrIL51mo-KpzgUkZbWW7ZUIlkH8lOTw
MAGOS_AUTOMATION_ID=MAGOS-DOC-EXTRACT-01
MAGOS_MAX_FILES_PER_RUN=25

# Google service authentication.
# Prefer GOOGLE_APPLICATION_CREDENTIALS in production.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# PDF.co is an escalation adapter, not the default extractor.
PDFCO_API_KEY=
PDFCO_OCR_MODE=Auto
PDFCO_ENABLE_AI_INVOICE=false
PDFCO_TEMPLATE_MAP_JSON={}

# Minimum native text quality before paid OCR is considered.
MAGOS_NATIVE_MIN_CHARS=80
MAGOS_NATIVE_MIN_ALNUM_RATIO=0.25
