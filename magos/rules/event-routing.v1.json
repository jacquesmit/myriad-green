      "minimumConfidence": 0.98
    },
    "MESSAGE_RECEIVED": {
      "allowAutoWrite": false,
      "allowCreateWithoutExistingMatch": false,
      "minimumConfidence": 1
    },
    "DOCUMENT_FILED": {
      "allowAutoWrite": true,
      "allowCreateWithoutExistingMatch": false,
      "minimumConfidence": 1
    },
    "SUPPLIER_PRICE_OBSERVED": {
      "allowAutoWrite": true,
