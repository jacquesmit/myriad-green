{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myriadgreen.co.za/magos/transaction-plan.v1.schema.json",
  "title": "MAGOS TransactionPlan V1",
  "type": "object",
  "required": ["idempotency_key", "event_type", "source_event_id", "preconditions", "writes"],
  "properties": {
    "transaction_id": {"type": "string"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string", "minLength": 1},
    "trigger_type": {"type": "string"},
    "input_scope": {"type": "string"},
    "evidence_link": {"type": "string"},
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["store", "sheet", "key", "expect"],
        "properties": {
          "store": {"type": "string"},
          "sheet": {"type": "string"},
          "key": {
            "type": "object",
            "required": ["header", "value"],
            "properties": {
              "header": {"type": "string"},
              "value": {}
            }
          },
          "expect": {"type": "object"}
        }
      }
    },
    "writes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["store", "workbook_role", "sheet", "operation", "key", "authority"],
        "properties": {
          "store": {"type": "string"},
          "workbook_role": {"type": "string"},
          "sheet": {"type": "string"},
          "operation": {
            "enum": [
              "UPDATE_BY_KEY",
              "APPEND_IF_ABSENT",
              "CREATE_IF_ABSENT",
              "UPSERT_BY_KEY",
              "PATCH_IF_MATCH",
              "STATE_TRANSITION",
              "SET_IF_EMPTY"
            ]
          },
          "intent": {"type": "string"},
          "key": {
            "type": "object",
            "required": ["header", "value"],
            "properties": {
              "header": {"type": "string"},
              "value": {}
            }
          },
          "authority": {"enum": ["AUTHORITATIVE", "CROSS_SYSTEM_LINK"]},
          "entity_type": {"type": "string"},
          "link_id": {"type": "string"},
          "required_headers": {"type": "array", "items": {"type": "string"}},
          "changes": {"type": "object"},
          "values": {"type": "object"},
          "expect": {"type": "object"},
          "state_field": {"type": "string"},
          "from_state": {},
          "from_states": {"type": "array"},
          "to_state": {}
        }
      }
    }
  },
  "additionalProperties": true
}
